{
  "manifest_version": 3,
  "name": "EliteYT",
  "version": "0.2.0",
  "description": "YouTube ad blocker, AI and low-effort video filter, SponsorBlock, DeArrow, dislikes, speed controls, battery saver, custom layouts.",
  "browser_specific_settings": {
    "gecko": { "id": "eliteyt@dronzer-studios", "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["browsingActivity"] } },
    "gecko_android": { "strict_min_version": "142.0" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://www.youtube.com/*", "https://sponsor.ajay.app/*", "https://dearrow-thumb.ajay.app/*", "https://returnyoutubedislikeapi.com/*"],
  "action": { "default_title": "EliteYT Layout Studio", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background.js", "scripts": ["src/defaults.js", "src/profiles.js", "src/background.js"] },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/defaults.js", "src/profiles.js", "src/bridge.js"],
      "css": ["src/style.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/adblock.js", "src/main.js", "src/pieces.js", "src/sponsor.js", "src/home.js", "src/slop.js", "src/contentid.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
